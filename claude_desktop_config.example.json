{
  "_comment": [
    "RepoLens MCP – Claude Desktop integration configs",
    "",
    "WINDOWS PATH (AppData):",
    "  %APPDATA%\\Claude\\claude_desktop_config.json",
    "  e.g. C:\\Users\\<YourUser>\\AppData\\Roaming\\Claude\\claude_desktop_config.json",
    "",
    "macOS PATH:",
    "  ~/Library/Application Support/Claude/claude_desktop_config.json",
    "",
    "Instructions:",
    "  1. Copy the block for your OS into the real claude_desktop_config.json.",
    "  2. If claude_desktop_config.json already has other servers, merge the",
    "     'repolens' key into the existing 'mcpServers' object.",
    "  3. Adjust REPO_PATH to the repository you want to index.",
    "  4. Restart Claude Desktop after saving."
  ],

  "windows": {
    "mcpServers": {
      "repolens": {
        "command": "E:\\PROJECTS\\PYTHON PROJECTS\\Repolens-mcp\\.venv\\Scripts\\python.exe",
        "args": [
          "E:\\PROJECTS\\PYTHON PROJECTS\\Repolens-mcp\\src\\server.py"
        ],
        "env": {
          "REPO_PATH": "E:\\PROJECTS\\PYTHON PROJECTS\\Repolens-mcp",
          "CHROMA_PATH": "E:\\PROJECTS\\PYTHON PROJECTS\\Repolens-mcp\\chroma_db",
          "PYTHONPATH": "E:\\PROJECTS\\PYTHON PROJECTS\\Repolens-mcp"
        }
      }
    }
  },

  "macos": {
    "mcpServers": {
      "repolens": {
        "command": "/path/to/your/venv/bin/python",
        "args": [
          "/path/to/your/repolens-mcp/src/server.py"
        ],
        "env": {
          "REPO_PATH": "/path/to/your/repolens-mcp",
          "CHROMA_PATH": "/path/to/your/repolens-mcp/chroma_db",
          "PYTHONPATH": "/path/to/your/repolens-mcp"
        }
      }
    }
  }
}
